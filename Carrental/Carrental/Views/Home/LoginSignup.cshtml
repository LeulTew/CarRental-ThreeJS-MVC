@using Carrental.Models;
@model LoginSignupViewModel
@{
    Layout = null; 
    ViewData["Title"] = "LoginSignup";
}



<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/login.css">
</head>
<body>
    <div class="login2main">
        <div class="form-container">
            <div id="signupForm">
                <p class="title">Sign up</p>
                <form asp-controller="Admin" asp-action="Create" method="post" class="form" autocomplete="off">
                    <div class="input-group">
                        <label asp-for="User.FullName">Full Name</label>
                        <input asp-for="User.FullName" id="User_FullName" placeholder="">
                        <span asp-validation-for="User.FullName"></span>
                    </div>
                    <div class="input-group">
                        <label asp-for="User.Email">Email</label>
                        <input asp-for="User.Email" type="email" id="User_Email" placeholder="">
                        <span asp-validation-for="User.Email"></span>
                    </div>
                    <div class="input-group">
                        <label asp-for="User.Phone">Phone</label>
                        <input asp-for="User.Phone" id="User_Phone" placeholder="">
                        <span asp-validation-for="User.Phone"></span>
                    </div>
                    <div class="input-group">
                        <label asp-for="User.Password">Password</label>
                        <input asp-for="User.Password" type="password" id="User_Password" placeholder="">
                        <span asp-validation-for="User.Password"></span>
                    </div>

                    <div class="input-group" id="lastinput">
                        <label asp-for="User.ConfirmPassword">Confirm Password</label>
                        <input asp-for="User.ConfirmPassword" type="password" id="User_ConfirmPassword" placeholder="">
                        <span asp-validation-for="User.ConfirmPassword"></span>
                    </div>
                    <button class="sign" type="submit">Sign up</button>
                </form>

                <div class="social-message">
                    <div class="line"></div>
                    <p class="message">Login with social accounts</p>
                    <div class="line"></div>
                </div>
                <div class="social-icons">
                    @if (Model.ExternalLogins.Count > 0)
                    {
                        <form method="post" asp-controller="Account" asp-action="ExternalLogin" asp-route-returnUrl="@Model.Login.ReturnUrl" class="external-login-form">
                            @foreach (var provider in Model.ExternalLogins)
                            {
                                <button type="submit" name="provider" value="@provider.Name" aria-label="Log in with Google" class="icon">
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" class="w-5 h-5 fill-current">
