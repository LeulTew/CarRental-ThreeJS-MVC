                    </button>
                </div>
                <p class="signup">
                    Already have an account?
                    <a asp-action="Index" asp-controller="Car" class="btn btn-secondary"></a>
                    <a rel="noopener noreferrer" href="#" id="showLoginForm">Log in</a>
                </p>
            </div>

            <div id="loginForm" style="display: block;">
                <!-- Set display to block to show the login form -->
                <p class="title">Log in</p>
                <form class="form" autocomplete="off" asp-controller="Account" asp-action="Login" method="post">
                    <input type="hidden" asp-for="Login.ReturnUrl" />
                    <!-- Login fields -->
                    <div class="input-group">
                        <label asp-for="Login.Email">Email</label>
                        <input asp-for="Login.Email" type="email" id="Login_Email" placeholder="">
                        <span asp-validation-for="Login.Email"></span>
                    </div>
                    <div class="input-group">
                        <label asp-for="Login.Password">Password</label>
                        <input asp-for="Login.Password" type="password" id="Login_Password" placeholder="">
                        <span asp-validation-for="Login.Password"></span>
                    </div><br />
                    <div class="form-group" id="lastinput">
                        <label>
                            <input type="checkbox" asp-for="Login.Remember" />
                            Remember Me?
                        </label>
                    </div>
                    <button class="sign" type="submit">Login</button>
                </form>
                <div class="forgot-container">
                <a asp-action="ForgotPassword" asp-controller="Account" class="forgot-password">Forgot Password?</a>
                </div>
                <div class="social-message">
                    <div class="line"></div>
                    <p class="message">Login with social accounts</p>
                    <div class="line"></div>
