                    <div class="text">Logout</div>
                </button>
            </div>
        }
    </div>

    @*
    <footer class="border-top footer text-muted">
    <div class="container">
    &copy; 2024 - Carrental - <a asp-area="" asp-page="/Privacy">Privacy</a>
    </div>

    </footer>
    *@
    <footer>
        @await Html.PartialAsync("_Footer.cshtml")
    </footer>




    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const navLinks = document.querySelectorAll(".nav-bar__link");
            const currentUrl = window.location.pathname;

            navLinks.forEach((link) => {
                // Remove is-active class from all links
                link.classList.remove("is-active");

                // Find the link corresponding to the current URL and add is-active class to it
                if (link.getAttribute("href") === currentUrl) {
                    link.classList.add("is-active");
                }
            });

            // Event listener for click events on links
            navLinks.forEach((link) => {
                link.addEventListener("click", () => {
                    const currentActiveLink = document.querySelector(".nav-bar__link.is-active");
                    currentActiveLink.classList.remove("is-active");
                    link.classList.add("is-active");
                });
            });
        });
    </script>

    <script>
        function logout() {
            // Perform logout action here, such as redirecting to the logout endpoint
            window.location.href = '@Url.Action("Logout", "Account")';
        }
    </script>


    <!-- JavaScript to handle search button click -->
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var controllerName = "@controllerName";
            var actionName = "@actionName";
            const searchButton = document.getElementById('search-button');
            const searchButtonAlt = document.getElementById('search-button-alt');
            const searchContainer = document.getElementById('search-container');


            // Toggle visibility of search container on button click
            searchButton.addEventListener('click', toggleSearchContainer);
            searchButtonAlt.addEventListener('click', toggleSearchContainer);

            // Function to toggle search container visibility
            function toggleSearchContainer() {
                searchContainer.classList.toggle('show');
            }
        });



        const searchInput = document.getElementById('search-input');
        const micButton = document.getElementById('micButton');

        if (navigator.mediaDevices && navigator.mediaDevices.getUserMedia) {
            micButton.addEventListener('click', async () => {
                try {
                    const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
                    const recorder = new MediaRecorder(stream);
                    const audioChunks = [];

                    recorder.addEventListener('dataavailable', (event) => {
                        audioChunks.push(event.data);
                    });

                    recorder.addEventListener('stop', async () => {
                        const audioBlob = new Blob(audioChunks);
                        const audioFile = new File([audioBlob], 'speech.wav', { type: 'audio/wav' });

                        const formData = new FormData();
                        formData.append('audio', audioFile);

                        const response = await fetch('/SpeechToText', {
                            method: 'POST',
                            body: formData,
                        });

                        if (response.ok) {
                            const transcription = await response.text();
                            if (searchInput) {
                                searchInput.value = transcription; // Update the search input with the transcribed text
                            } else {
                                console.error('Search input element not found.');
                            }
                        } else {
                            console.error('Error:', response.statusText);
                        }
                    });

                    recorder.start();
                    setTimeout(() => {
                        recorder.stop();
                        stream.getTracks().forEach(track => track.stop()); // Stop audio stream
                    }, 3000); // Adjust the duration as needed
                } catch (error) {
                    console.error('Error:', error);
                }
            });
        } else {
            console.error('getUserMedia not supported in this browser.');
        }

    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
