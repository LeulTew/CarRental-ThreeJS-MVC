@model Carrental.Models.CarViewModel

@{
    Layout = "_Layout";
}
<link rel="stylesheet" href="~/css/AddCar.css">




<form asp-controller="Car" asp-action="Create" enctype="multipart/form-data" method="post" class="mt-3 futuristic-form">
   
<div class="back-button">
    <button onclick="goBack()">Back</button>
</div>

    <h4>Car Entry Form</h4>
    <hr />
    <div class="form-group row">
        <label asp-for="Make" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="Make" class="form-control mb-2" />
            <span asp-validation-for="Make" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="Model" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="Model" class="form-control mb-2" />
            <span asp-validation-for="Model" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="Year" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="Year" class="form-control mb-2" />
            <span asp-validation-for="Year" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="Description" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="Description" class="form-control mb-2" />
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="Seats" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="Seats" class="form-control mb-2" />
            <span asp-validation-for="Seats" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="Color" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="Color" class="form-control mb-2" />
            <span asp-validation-for="Color" class="text-danger"></span>
        </div>
    </div>

    <div class="custom-select">
        <select class="car-type-select" asp-for="CarType">
            <option value="">Select Car Type</option>
            <option value="Sedan">Sedan</option>
            <option value="Wagon">Wagon</option>
            <option value="Van">Van</option>
            <option value="Minivan">Minivan</option>
            <option value="Pickup">Pickup</option>
            <option value="Coupe">Coupe</option>
            <option value="Hatchback">Hatchback</option>
            <option value="SUV">SUV</option>
        </select>
        <span asp-validation-for="CarType" class="text-danger"></span>
    </div>



    <div class="form-group row">
        <label asp-for="Condition" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="Condition" class="form-control mb-2" />
            <span asp-validation-for="Condition" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="RentPricePerHour" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="RentPricePerHour" class="form-control mb-2" />
            <span asp-validation-for="RentPricePerHour" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="SalePrice" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="SalePrice" class="form-control mb-2" />
            <span asp-validation-for="SalePrice" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="IsForSale" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="IsForSale" class="form-check-input mb-2" />
            <span asp-validation-for="IsForSale" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="Specifications" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <textarea asp-for="Specifications" class="form-control mb-2"></textarea>
            <span asp-validation-for="Specifications" class="text-danger"></span>
        </div>
    </div>

    <!-- For single image upload (Image) -->
    <div class="form-group">
        <label asp-for="Image" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <label class="custum-file-upload" for="Image">
                <div class="icon">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="" viewBox="0 0 24 24">
                        <g stroke-width="0" id="SVGRepo_bgCarrier"></g>
                        <g stroke-linejoin="round" stroke-linecap="round" id="SVGRepo_tracerCarrier"></g>
                        <g id="SVGRepo_iconCarrier">
                            <path fill="" d="M10 1C9.73478 1 9.48043 1.10536 9.29289 1.29289L3.29289 7.29289C3.10536 7.48043 3 7.73478 3 8V20C3 21.6569 4.34315 23 6 23H7C7.55228 23 8 22.5523 8 22C8 21.4477 7.55228 21 7 21H6C5.44772 21 5 20.5523 5 20V9H10C10.5523 9 11 8.55228 11 8V3H18C18.5523 3 19 3.44772 19 4V9C19 9.55228 19.4477 10 20 10C20.5523 10 21 9.55228 21 9V4C21 2.34315 19.6569 1 18 1H10ZM9 7H6.41421L9 4.41421V7ZM14 15.5C14 14.1193 15.1193 13 16.5 13C17.8807 13 19 14.1193 19 15.5V16V17H20C21.1046 17 22 17.8954 22 19C22 20.1046 21.1046 21 20 21H13C11.8954 21 11 20.1046 11 19C11 17.8954 11.8954 17 13 17H14V16V15.5ZM16.5 11C14.142 11 12.2076 12.8136 12.0156 15.122C10.2825 15.5606 9 17.1305 9 19C9 21.2091 10.7909 23 13 23H20C22.2091 23 24 21.2091 24 19C24 17.1305 22.7175 15.5606 20.9844 15.122C20.7924 12.8136 18.858 11 16.5 11Z" clip-rule="evenodd" fill-rule="evenodd"></path>
                        </g>
                    </svg>
                </div>
                <div class="text">
                    <span>Click to upload image</span>
                </div>
                <input type="file" id="Image" name="Image" onchange="previewImage(event, 'ImagePreview')" style="display: none;">
            </label>
            <div id="ImagePreview"></div> <!-- Image preview container -->
        </div>
    </div>

    <!-- For multiple image upload (Images) -->
    <div class="form-group">
        <label asp-for="Images" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <label class="custum-file-upload" for="Images">
                <div class="icon">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="" viewBox="0 0 24 24">
                        <g stroke-width="0" id="SVGRepo_bgCarrier"></g>
                        <g stroke-linejoin="round" stroke-linecap="round" id="SVGRepo_tracerCarrier"></g>
                        <g id="SVGRepo_iconCarrier">
                            <path fill="" d="M10 1C9.73478 1 9.48043 1.10536 9.29289 1.29289L3.29289 7.29289C3.10536 7.48043 3 7.73478 3 8V20C3 21.6569 4.34315 23 6 23H7C7.55228 23 8 22.5523 8 22C8 21.4477 7.55228 21 7 21H6C5.44772 21 5 20.5523 5 20V9H10C10.5523 9 11 8.55228 11 8V3H18C18.5523 3 19 3.44772 19 4V9C19 9.55228 19.4477 10 20 10C20.5523 10 21 9.55228 21 9V4C21 2.34315 19.6569 1 18 1H10ZM9 7H6.41421L9 4.41421V7ZM14 15.5C14 14.1193 15.1193 13 16.5 13C17.8807 13 19 14.1193 19 15.5V16V17H20C21.1046 17 22 17.8954 22 19C22 20.1046 21.1046 21 20 21H13C11.8954 21 11 20.1046 11 19C11 17.8954 11.8954 17 13 17H14V16V15.5ZM16.5 11C14.142 11 12.2076 12.8136 12.0156 15.122C10.2825 15.5606 9 17.1305 9 19C9 21.2091 10.7909 23 13 23H20C22.2091 23 24 21.2091 24 19C24 17.1305 22.7175 15.5606 20.9844 15.122C20.7924 12.8136 18.858 11 16.5 11Z" clip-rule="evenodd" fill-rule="evenodd"></path>
                        </g>
                    </svg>
                </div>
                <div class="text">
                    <span>Click to upload image</span>
                </div>
                <input type="file" id="Images" name="Images" onchange="previewImages(event, 'ImagesPreview')" multiple style="display: none;">
            </label>
            <div id="ImagesPreview"></div> <!-- Image preview container -->
        </div>
    </div>

    <div class="form-group">
        <input type="submit" value="Create" class="btn btn-primary mb-2" />
    </div>
</form>



<script>

    function goBack() {
        window.history.back();
    }

    // Function to preview single image
    function previewImage(event, previewId) {
        var reader = new FileReader();
        reader.onload = function () {
            var output = document.getElementById(previewId);
            output.innerHTML = '<img src="' + reader.result + '" width="150" />';
        }
        reader.readAsDataURL(event.target.files[0]);
    }

    // Function to preview multiple images
    function previewImages(event, previewId) {
        var reader = new FileReader();
        reader.onload = function () {
            var output = document.getElementById(previewId);
            output.innerHTML = ''; // Clear previous previews
            for (var i = 0; i < event.target.files.length; i++) {
                output.innerHTML += '<img src="' + URL.createObjectURL(event.target.files[i]) + '" width="150" />';
            }
        }
        reader.readAsDataURL(event.target.files[0]);
    }

</script>