    <hr />

	<h2>Payment Form</h2>
    
    <form id="paymentForm" asp-action="ProcessPayment" asp-controller="Car" method="post">
        <input type="hidden" name="UserName" value="@Model.UserName" />
        <input type="hidden" name="PaymentMethod" value="Credit" />
        <input type="hidden" name="BookingId" value="@Model.BookingId" />
        <input type="hidden" name="TransactionId" value="@Model.TransactionId" />
        <input type="hidden" name="TotalAmount" value="@Model.TotalAmount" />
        <div class="form-group">
            <label for="cardNumber">Card Number:</label>
            <input type="text" class="form-control" id="cardNumber" name="CardNumber" required />
            <div class="error-message" id="cardNumberError"></div>
        </div>
        <div class="form-group">
            <label for="expiryDate">Expiry Date:</label>
            <input type="month" class="form-control" id="expiryDate" name="ExpiryDate" required />
            <div class="error-message" id="expiryDateError"></div>
        </div>
        <div class="form-group">
            <label for="cvv">CVV:</label>
            <input type="text" class="form-control" id="cvv" name="CVV" required />
            <div class="error-message" id="cvvError"></div>
        </div>
        <div class="payment-container" id="proceedButton">
            <div class="payment-left">
                <div class="payment-card">
                    <div class="payment-card-line"></div>
                    <div class="payment-buttons">
                    </div>
                </div>
                <div class="payment-post">
                    <div class="payment-post-line"></div>
                    <div class="payment-screen">
                        <div class="payment-dollar">Br.</div>
                    </div>
                    <div class="payment-numbers"></div>
                    <div class="payment-numbers-line2"></div>
                </div>
            </div>
            <div class="payment-right">
                <div class="payment-checkout">Checkout</div>
            </div>
        </div>
    </form>
    <div class="PayOpt">
        <!-- PayPal payment option -->
        <form id="paypalForm" action="@Url.Action("PayUsingPayPal", "Car")" method="post">
            <input type="hidden" name="BookingId" value="@Model.BookingId" />
            <input type="hidden" name="TotalAmount" value="@Model.TotalAmount" />

            <div class="payPalWhite">
                <div class="responsivePayPalWhite">
                    <button type="button" onclick="submitPayPalForm()" class="btn btn-primary">
                        <img src="https://www.paypalobjects.com/webstatic/en_US/i/buttons/PP_logo_h_100x26.png" alt="Check out with PayPal" />
                    </button>
                </div>
            </div>

        </form>

        <button type="button" class="btn btn-danger" onclick="confirmCancel()">Cancel Payment</button>
    </div>

    <!-- Confirmation Popup -->
    <div id="confirmationModal" class="modal fade" role="dialog">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h4 class="modal-title">Confirm Payment</h4>
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to proceed with the payment?</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-cancel" id="cancelBtn">Cancel</button>
                    <button type="button" onclick="submitPayment()" class="btn-new">Yes, Proceed</button>
                </div>
            </div>
        </div>
    </div>
    <!-- Cancel Payment Popup -->
    <div id="cancelModal" class="modal fade" role="dialog">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h4 class="modal-title">Cancel Payment</h4>
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to cancel the payment?</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">No</button>
                    <a id="confirmCancelBtn" href="/Car/Cancel?bookingId=@Model.BookingId" class="btn btn-danger">Yes, Cancel</a>
                </div>
            </div>
        </div>
    </div>




    @section Scripts {
        <script>

            function submitPayPalForm() {
                document.getElementById("paypalForm").submit();
            }
            function confirmCancel() {
                $('#cancelModal').modal('show');
            }

            function showConfirmationPopup() {
                $('#confirmationModal').modal('show');
            }

            function submitPayment() {
                $('#paymentForm').submit();
            }
            document.getElementById('cancelBtn').addEventListener('click', function () {
                $('#confirmationModal').modal('hide');
            });

            document.getElementById('proceedButton').addEventListener('click', function () {
                var cardNumber = document.getElementById('cardNumber');
                var expiryDate = document.getElementById('expiryDate');
                var cvv = document.getElementById('cvv');

                if (!cardNumber.checkValidity()) {
                    document.getElementById('cardNumberError').textContent = cardNumber.validationMessage;
                    document.getElementById('cardNumberError').classList.remove('hide');
                    return;
                }
                document.getElementById('cardNumberError').classList.add('hide');

                if (!expiryDate.checkValidity()) {
                    document.getElementById('expiryDateError').textContent = expiryDate.validationMessage;
                    document.getElementById('expiryDateError').classList.remove('hide');
                    return;
                }
                document.getElementById('expiryDateError').classList.add('hide');

                if (!cvv.checkValidity()) {
                    document.getElementById('cvvError').textContent = cvv.validationMessage;
                    document.getElementById('cvvError').classList.remove('hide');
                    return;
                }
                document.getElementById('cvvError').classList.add('hide');

                showConfirmationPopup();
            });


            function updateCardDetails() {
                // Retrieve input values
                var cardNumber = document.getElementById('cardNumber').value;
                var expiryDate = document.getElementById('expiryDate').value;
                var cvv = document.getElementById('cvv').value;

                // Update card number display
                document.querySelector('.flip-card .number').innerText = cardNumber;

                // Format expiry date (assuming MM/YY format)
                var formattedExpiryDate = expiryDate.slice(0, 2) + '/' + expiryDate.slice(2);
                document.querySelector('.flip-card .date_8264').innerText = formattedExpiryDate;

                // Update CVV display
                document.querySelector('.flip-card-back .code').innerText = cvv;
            }

            // Event listener for input changes
            document.getElementById('cardNumber').addEventListener('input', updateCardDetails);
            document.getElementById('expiryDate').addEventListener('input', updateCardDetails);
            document.getElementById('cvv').addEventListener('input', updateCardDetails);
        </script>
    }
</div>
