    <!-- Avatar icon -->
    <symbol id="avatar" width="32" height="32" viewBox="0 0 44.25 44">
        <title>Avatar</title>
        <path style="fill: #7226e0; fill-rule: evenodd;" d="M1035.88,1696.25a22,22,0,1,1-22.13,22A22.065,22.065,0,0,1,1035.88,1696.25Z" transform="translate(-1013.75 -1696.25)" />
        <path style="fill: #fff; fill-rule: evenodd;" d="M1030.18,1725.16h2.35a0.335,0.335,0,0,0,.34-0.33v-5.23h5.94v5.23a0.342,0.342,0,0,0,.34.33h2.36a0.342,0.342,0,0,0,.34-0.33v-12.36a0.34,0.34,0,0,0-.34-0.32h-2.36a0.34,0.34,0,0,0-.34.32v4.51h-5.94v-4.51a0.333,0.333,0,0,0-.34-0.32h-2.35a0.333,0.333,0,0,0-.34.32v12.36a0.335,0.335,0,0,0,.34.33" transform="translate(-1013.75 -1696.25)" />
    </symbol>

</svg>


@section Scripts {
    <script src="~/js/Detail.js"> </script>
    <script>
      



        // Function to calculate total amount
        function calculateTotalAmount() {
            // Retrieve rental start and end dates
            var startDate = document.getElementById('rentalStartDate').value;
            var endDate = document.getElementById('rentalEndDate').value;

            // Check if both start and end dates are selected
            if (startDate && endDate) {
                startDate = new Date(startDate);
                endDate = new Date(endDate);

                // Calculate duration in hours
                var durationInHours = (endDate - startDate) / (1000 * 60 * 60);

                // Retrieve rental price per hour from the model
                var rentalPricePerHour = @Model.Car.RentPricePerHour;

                // Calculate total amount
                var totalAmount = durationInHours * rentalPricePerHour;

                // Update total amount display
                document.getElementById('totalAmount').style.display = 'block';
                document.getElementById('totalAmount').innerText = 'Br.' + totalAmount.toFixed(2);

                // Set the value of hidden input field for total amount
                document.getElementById('totalAmountInput').value = totalAmount.toFixed(2);

                // Show error message if total amount is less than 0.00
                if (totalAmount < 0) {
                    document.getElementById('dateErrorMessage').style.display = 'block';
                } else {
                    // Hide error message if total amount is valid
                    document.getElementById('dateErrorMessage').style.display = 'none';
                }
            } else {
                // If either start or end date is not selected, hide the total amount and show error message
                document.getElementById('totalAmount').style.display = 'none';
                // Only show error message when the form is submitted
                if (submitted) {
                    document.getElementById('dateErrorMessage').style.display = 'block';
                }
            }
        }

        // Variable to track whether the form has been submitted
        var submitted = false;

        // Event listener for Proceed to Pay button click
        document.getElementById('paymentButton').addEventListener('click', function () {
            // Validate dates before submitting the form
            calculateTotalAmount();
            var totalAmount = parseFloat(document.getElementById('totalAmountInput').value);
            if (!totalAmount || totalAmount === 0) {
                // Prevent form submission if total amount is not calculated
                submitted = true;
                return false;
            }
            // Submit the form if total amount is calculated
            submitted = false;
            document.getElementById('rentalForm').submit();
        });

        // Event listeners for Rental Start Date and End Date changes
        document.getElementById('rentalStartDate').addEventListener('change', calculateTotalAmount);
        document.getElementById('rentalEndDate').addEventListener('change', calculateTotalAmount);

        // Initially calculate total amount
        calculateTotalAmount();
    </script>
}

